<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý Sách</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 1000px;
      margin: 30px auto;
      padding: 0 20px;
      background: #f5f7fb;
      color: #243047;
    }

    section {
      background: white;
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 10px;
    }

    label {
      display: block;
      margin-top: 12px;
    }

    input {
      width: 100%;
      box-sizing: border-box;
      padding: 10px;
      margin-top: 5px;
      border: 1px solid #bbb;
      border-radius: 5px;
    }

    button {
      margin-top: 16px;
      padding: 10px 20px;
      background: #176b45;
      color: white;
      border: 0;
      border-radius: 5px;
      cursor: pointer;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid #ddd;
      padding: 10px;
      text-align: left;
    }

    th {
      background: #eef3f8;
    }

    .error {
      color: #a40000;
      background: #ffe5e5;
      padding: 12px;
    }

    footer {
      padding: 20px 0;
      text-align: center;
      border-top: 1px solid #ccc;
    }
  </style>
</head>

<body>
  <h1>Quản lý Sách</h1>
    {{#if sessionViews}}
  <p>Số lần xem trang trong phiên hiện tại: {{sessionViews}}</p>
{{/if}}
  <section>
    <h2>Thêm sách</h2>
    <p>Mã sách phải bắt đầu bằng {{codePrefix}}.</p>

    {{#if error}}
      <p class="error">{{error}}</p>
    {{/if}}

    <form action="/books" method="POST">
      <label for="code">Mã sách</label>
      <input
        id="code"
        name="code"
        placeholder="Ví dụ: {{codePrefix}}-S001"
        value="{{form.code}}"
        required
      >

      <label for="title">Tên sách</label>
      <input
        id="title"
        name="title"
        value="{{form.title}}"
        required
      >

      <label for="price">Giá trước thuế (VNĐ)</label>
      <input
        id="price"
        name="price"
        type="number"
        min="0"
        step="0.01"
        value="{{form.price}}"
        required
      >

      <button type="submit">Thêm sách</button>
    </form>
  </section>

  <section>
    <h2>Danh sách sách</h2>

    <table>
      <thead>
        <tr>
          <th>Mã sách</th>
          <th>Tên sách</th>
          <th>Giá trước thuế</th>
          <th>VAT</th>
          <th>Giá sau thuế</th>
        </tr>
      </thead>

      <tbody>
        {{#each books}}
          <tr>
            <td>{{code}}</td>
            <td>{{title}}</td>
            <td>{{money price}} đ</td>
            <td>{{vatPercent}}%</td>
            <td>{{money priceAfterTax}} đ</td>
          </tr>
        {{else}}
          <tr>
            <td colspan="5">Chưa có sách.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  <footer>
    {{studentName}} |
    MSSV: {{studentId}} |
    VAT áp dụng: {{vatPercent}}%
  </footer>
</body>
</html>